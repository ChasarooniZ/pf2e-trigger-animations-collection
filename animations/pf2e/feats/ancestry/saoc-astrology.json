          "connection": "d3PHpZbVJWrt310T:outputs:LmlMo1cQGk8jUz1o"
        },
        "script": {
          "value": "/**\n * @param {unknown[]} inputs\n * @returns {boolean} to break out current process\n * @returns {{type: EntryType; value: unknown}[]}\n *\n * @example\n * const x = inputs[0];\n * const y = inputs[1];\n * return [{type: \"number\", value: x + y}];\n */\nconst badge = inputs[0];\nconst actor = inputs[1].actor;\nconst heir = actor?.rollOptions?.all?.[\"feat:heir-of-the-saoc\"]\nconst res = {\n  filter: {},\n  sfx: \"ggg-sfx.magic.occult.buff.general.01.01\"\n};\nif (heir) {\n  if ([2,3,4].includes(badge)) {\n    res.filter = {hue: -75};\n    res.sfx = 'ggg-sfx.magic.arcane.buff.general.03.01'\n  } else {\n    res.filter = {hue: 110};\n    res.sfx = 'ggg-sfx.magic.occult.curse.bells.01.02'\n  }\n} else {\n  if ([6,7,8].includes(badge)) {\n    res.filter = {hue: -75};\n    res.sfx = 'ggg-sfx.magic.arcane.buff.general.03.01'\n  } else if ([3,4,5].includes(badge)) {\n    res.filter = {};\n    res.sfx = \"ggg-sfx.magic.occult.buff.general.01.01\"\n  } else if (badge === 2) {\n    res.filter = {hue: 155};\n    res.sfx = 'ggg-sfx.magic.occult.buff.general.01.03'\n  } else {\n    res.filter = {hue: 110};\n    res.sfx = 'ggg-sfx.magic.occult.curse.bells.01.02'\n  }\n}\nreturn [\n  {type: \"text\", value: JSON.stringify(res.filter)},\n  {type: \"text\", value: res.sfx},\n];"
        },
        "zoPZtEiFFbMMlGnr": {
          "connection": "xLsrqBIPvMuUXVAQ:outputs:actor"
        }
