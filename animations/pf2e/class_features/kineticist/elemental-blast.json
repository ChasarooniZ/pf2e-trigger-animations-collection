      "inputs": {
        "SPXVDPkTqTVHeae9": {
          "connection": "uiiIjJhTAmgZWGpc:outputs:options"
        },
        "script": {
          "value": "/**\n * @param {unknown[]} inputs\n * @returns {boolean} to break out current process\n * @returns {{type: EntryType; value: unknown}[]}\n *\n * @example\n * const x = inputs[0];\n * const y = inputs[1];\n * return [{type: \"number\", value: x + y}];\n */\nconst options = inputs[0];\nconst jb2aPatron = game.modules.get(\"jb2a_patreon\")?.active;\nconst elementList = [\"air\", \"earth\", \"fire\", \"metal\", \"water\", \"wood\"];\nconst element = options.find((op) => elementList.includes(op));\nconst isRanged = options.includes(\"ranged\");\n\nconst data = {\n  ranged: \"\",\n  rangedSFX: \"\",\n  target: \"\",\n  targetSFX: \"\",\n  rangedSFXDelay: 0,\n  targetDelay: 0,\n};\n\nswitch (element) {\n  case \"air\": {\n    if (options.includes(\"electricity\")) {\n      data.ranged = \"jb2a.chain_lightning.primary.blue\";\n      data.rangedSFX = \"ggg-sfx.magic.electricity.lightning_bolt.01.cast\";\n      data.target = \"jb2a.static_electricity.03.blue\";\n      data.targetSFX = \"ggg-sfx.magic.electricity.lightning_bolt.01.impact\";\n      data.targetDelay = -1000;\n    } else {\n      data.ranged = jb2aPatron\n        ? \"jb2a.spell_projectile.earth.01.browngreen\"\n        : \"jb2a.gust_of_wind.veryfast\";\n      data.rangedSFX = \"ggg-sfx.magic.air.cast.gust.01\";\n      data.target = \"jb2a.smoke.puff.ring.01.white.0\";\n      data.targetSFX = 'ggg-sfx.magic.air.impact.turbine.01'\n      data.targetDelay = -1000;\n    }\n    break;\n  }\n  case \"earth\": {\n    data.ranged = \"jb2a.boulder.toss.02.01.stone.brown\";\n    data.rangedSFX = \"ggg-sfx.magic.earth.ranged.rock.02\";\n    data.rangedSFXDelay = 500;\n    data.target = jb2aPatron\n      ? \"jb2a.impact.earth.01.browngreen.0\"\n      : \"jb2a.impact.ground_crack.orange.03\";\n    data.targetSFX = \"ggg-sfx.magic.earth.impact.general.01.normal\";\n    data.targetDelay = -100;\n    break;\n  }\n  case \"fire\": {\n    data.ranged = \"jb2a.fire_bolt.orange\";\n    data.rangedSFX = \"ggg-sfx.magic.fire.cast.general.03\";\n    data.target = \"jb2a.flames.01.orange\";\n    data.targetSFX = \"ggg-sfx.magic.fire.impact.general.01\";\n    data.targetDelay = -600;\n    break;\n  }\n  case \"metal\": {\n    data.ranged = jb2aPatron\n      ? \"jb2a.dart.01.throw.physical.white.15ft\"\n      : \"jb2a.dagger.throw.01.white\";\n    data.rangedSFX = \"ggg-sfx.magic.metal.whoosh.general.01\";\n    data.rangedSFXDelay = 800;\n    data.target = \"jb2a.impact.003.blue\";\n    data.targetSFX = \"ggg-sfx.magic.metal.impact.anvil.02\";\n    data.targetDelay = -700;\n    break;\n  }\n  case \"water\": {\n    if (options.includes(\"cold\")) {\n      data.ranged = \"jb2a.spell_projectile.ice_shard.blue\";\n      data.rangedSFX = \"ggg-sfx.magic.ice.snowball.01.cast\";\n      data.rangedSFXDelay = -400;\n      data.target = \"jb2a.impact.ground_crack.frost.01.white\";\n      data.targetSFX = \"ggg-sfx.magic.ice.snowball.01.impact\";\n      data.targetDelay = -1800;\n    } else {\n      data.ranged = jb2aPatron ? \"jb2a.ranged.04.projectile.01.blue\" : \"jb2a.ranged.04.projectile.01.green\";\n      data.rangedSFX = \"ggg-sfx.magic.water.jet.01.cast\";\n      data.target = \"jb2a.impact.water.02.blue.0\";\n      data.targetSFX = \"ggg-sfx.magic.water.jet.01.impact\";\n      data.targetDelay = -1000;\n    }\n    break;\n  }\n  case \"wood\": {\n     if (options.includes(\"vitality\")) {\n      data.ranged = \"jb2a.ranged.03.projectile.01.bluegreen\";\n      data.rangedSFX = \"ggg-sfx.magic.divine.cast.bolt.01\";\n      data.rangedSFXDelay = 0;\n      data.target = \"jb2a.energy_strands.overlay.blue.01\";\n      data.targetSFX = \"ggg-sfx.magic.divine.impact.bolt.01\";\n      data.targetDelay = -1000;\n    } else {\n      data.ranged = \"jb2a.swirling_leaves.ranged.greenorange\";\n      data.rangedSFX = \"ggg-sfx.magic.primal.strike.vine.01\";\n      data.rangedSFXDelay = 0;\n      data.target = \"jb2a.impact.010.orange\";\n      data.targetSFX = \"ggg-sfx.impact.arrow.hit.01\";\n      data.targetDelay = -1000;\n    }\n    break;\n  }\n}\n\nreturn [\n  { type: \"text\", value: data.ranged },\n  { type: \"text\", value: data.target },\n  { type: \"text\", value: data.rangedSFX },\n  { type: \"text\", value: data.targetSFX },\n  { type: \"text\", value: data.rangedSFXDelay },\n  { type: \"text\", value: data.targetDelay },\n  { type: \"text\", value: element },\n];"
        }
      },
      "outs": {
