      "inputs": {
        "script": {
          "value": "/**\n * @param {unknown[]} inputs\n * @returns {boolean} to break out current process\n * @returns {{type: EntryType; value: unknown}[]}\n *\n * @example\n * const x = inputs[0];\n * const y = inputs[1];\n * return [{type: \"number\", value: x + y}];\n */\nconst tok = inputs?.[0]?.token?.object;\nconst target = inputs?.[1]?.token?.object;\nconst delay = inputs[2]\nlet res = -delay\n\nif (target && tok) {\n  const dist = tok.distanceTo(target);\n  if (dist <= 5) {\n    res += 1700\n  } else if (dist <= 30) {\n    res += 1867\n  } else if (dist <= 60) {\n    res += 2033 / 2\n  }  else {\n    res += 2200 / 3\n  } \n}\nif (res < 0) res += 1700\n\nreturn [{type: \"number\", value: res / 5}];"
        },
