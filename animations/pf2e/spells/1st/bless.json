          }
        }
      },
      "inputs": {
        "script": {
          "value": "const badge = Number(inputs[0]) ?? 1;\nconst sizeInFt = 5 + (badge * 10);\nconst tokenWidth = ((inputs[1]?.token ?? inputs[1]?.actor?.token)?.width ?? 1);\nconst size = (tokenWidth / 2 + (sizeInFt / 5)) * 2;\nreturn [{ type: \"number\", value: size * 1.3 }];"
        },
